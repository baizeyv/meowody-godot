[configuration]
entry_symbol = "meowody_library_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://bin/libmeowody.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libmeowody.windows.template_release.x86_64.dll"
macos.debug = "res://bin/libmeowody.macos.template_debug.framework"
macos.release = "res://bin/libmeowody.macos.template_release.framework"
linux.debug.x86_64 = "res://bin/libmeowody.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libmeowody.linux.template_release.x86_64.so"
android.debug.arm64 = "res://bin/libmeowody.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libmeowody.android.template_release.arm64.so"
ios.debug.arm64 = "res://bin/libmeowody.ios.template_debug.arm64.a"
ios.release.arm64 = "res://bin/libmeowody.ios.template_release.arm64.a"
